@article{RandomMatricesGraphonsZhu,
author = {Zhu, Y.},
title = {A graphon approach to limiting spectral distributions of Wigner-type matrices},
journal = {Random Structures \& Algorithms},
volume = {56},
number = {1},
pages = {251-279},
keywords = {graphon, homomorphism density, inhomogeneous random graph, spectral distribution, Wigner-type matrix},
doi = {https://doi.org/10.1002/rsa.20894},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/rsa.20894},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/rsa.20894},
abstract = {We present a new approach, based on graphon theory, to finding the limiting spectral distributions of general Wigner-type matrices. This approach determines the moments of the limiting measures and the equations of their Stieltjes transforms explicitly with weaker assumptions on the convergence of variance profiles than previous results. As applications, we give a new proof of the semicircle law for generalized Wigner matrices and determine the limiting spectral distributions for three sparse inhomogeneous random graph models with sparsity ω(1/n): inhomogeneous random graphs with roughly equal expected degrees, W-random graphs and stochastic block models with a growing number of blocks. Furthermore, we show our theorems can be applied to random Gram matrices with a variance profile for which we can find the limiting spectral distributions under weaker assumptions than previous results.},
year = {2020}
}


