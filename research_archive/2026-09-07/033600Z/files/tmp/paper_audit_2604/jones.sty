%% Formatting Theorem, Lemma, Remark environments

\floatstyle{ruled}
\newfloat{algorithm}{tbp}{loa}
\providecommand{\algorithmname}{Algorithm}
\floatname{algorithm}{\protect\algorithmname}

  \theoremstyle{plain}
  \setlength\topsep{0.2cm}
  \newtheorem{ctr}{Counter}[section]

  \newtheorem{proposition}[ctr]{Proposition}
  \newtheorem{lemma}[ctr]{Lemma}
  \newtheorem{corollary}[ctr]{Corollary}
  \newtheorem{example}[ctr]{Example}
  \newtheorem{conjecture}[ctr]{Conjecture}
  \newtheorem{question}[ctr]{Question}
  \newtheorem{fact}[ctr]{Fact}
  \newtheorem{definition}[ctr]{Definition}
  \newtheorem{remark}[ctr]{Remark}
  \newtheorem{claim}[ctr]{Claim}
  \newtheorem{observation}[ctr]{Observation}
  \newtheorem{hypothesis}[ctr]{Hypothesis}
  \newtheorem{assumption}[ctr]{Assumption}
  \newtheorem{bound}[ctr]{Bound}
  \newtheorem{warn}[ctr]{Warning}
  \newtheorem{problem}[ctr]{Problem}
  \newtheorem{notation}[ctr]{Notation}
  
  % using unnumbered environments is not advised
  \newtheorem*{conjecture*}{Conjecture}
  \newtheorem*{example*}{Example}
  \newtheorem*{question*}{Question}

% @ is normally not allowed in command names to distinguish user-defined commands from built-in commands
% change it an allowable letter to do some hacking
\makeatletter
  % Allow citations in theorem label
  \def\thmhead@plain#1#2#3{%
  \thmname{#1}\thmnumber{\@ifnotempty{#1}{ }\@upn{#2}}%
  \thmnote{ {\the\thm@notefont(#3)}}}
\let\thmhead\thmhead@plain
% make @ back to a non-letter i.e. "done hacking" 
\makeatother
 
  \newtheorem{theorem}[ctr]{Theorem}
  \newtheorem*{theorem*}{Theorem}
