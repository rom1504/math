\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bqf-paper}[2026/05/25 Standardized paper preamble]

% ============================================================
% Standardized paper style
% - This is a package, not a document class.
% - It keeps the old macros intact, but removes the nonstandard
%   layout/proof/section overrides that were making the paper
%   look unusual.
% - Uses a standard Times-like text/math setup with real small caps.
% ============================================================

% ---------- Fonts and core math ----------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{textcomp}

% Load AMS first; newtxmath is happier this way and avoids \Bbbk/openbox clashes.
\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{mathdots}
\RequirePackage{nicefrac}
\RequirePackage{upgreek}
\RequirePackage{longtable}


% More journal-standard than lmodern, and small caps are more reliable,
% especially in titles. If your TeX installation lacks newtx, replace
% these two lines by:
%   \RequirePackage{lmodern}
\RequirePackage{lmodern}

% ---------- Language and layout ----------
\RequirePackage[english]{babel}
\RequirePackage[top=1in, bottom=1in, left=0.7in, right=0.7in]{geometry}

\RequirePackage{microtype}

% Standard paragraph behavior.
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}
\setlength{\headheight}{15pt}
\setlength{\headsep}{10pt}

% ---------- Symbols / blackboard one ----------
\RequirePackage{bbm}
\RequirePackage{dsfont}
\RequirePackage{wasysym}

% ---------- Figures, tables, diagrams ----------
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{adjustbox}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{tikz}
\RequirePackage{tikz-cd}
\RequirePackage{pgf}

% ---------- Lists and code ----------
\RequirePackage{enumitem}
\RequirePackage{listings}

% ---------- Boxes, kept for compatibility ----------
\RequirePackage{mdframed}
\RequirePackage[skins]{tcolorbox}
\RequirePackage{framed}

% ---------- Color, links, references ----------
\RequirePackage{xcolor}

\definecolor{webgreen}{rgb}{0,.5,0}
\definecolor{webbrown}{rgb}{.6,0,0}

\RequirePackage[
    colorlinks=true,
    linkcolor=blue!50!black,
    citecolor=blue!50!black,
    urlcolor=blue!50!black,
    filecolor=webbrown
]{hyperref}
\RequirePackage[nameinlink,capitalize,noabbrev]{cleveref}

% ---------- Optional title helper ----------
% Usage:
%   \title{\paperTitleSmallCaps{The Grothendieck Constant Is Less Than ...}}
% This avoids asking LaTeX for a nonexistent bold-small-caps shape.
\newcommand{\paperTitleSmallCaps}[1]{%
  {\Large\normalfont\scshape #1}%
}

% ============================================================
% Math-operator redeclaration helper
% Kept from the old style file.
% ============================================================

\makeatletter
\newcommand\RedeclareMathOperator{%
  \@ifstar{\def\rmo@s{m}\rmo@redeclare}{\def\rmo@s{o}\rmo@redeclare}%
}
% this is taken from \renew@command
\newcommand\rmo@redeclare[2]{%
  \begingroup \escapechar\m@ne\xdef\@gtempa{{\string#1}}\endgroup
  \expandafter\@ifundefined\@gtempa
     {\@latex@error{\noexpand#1undefined}\@ehc}%
     \relax
  \expandafter\rmo@declmathop\rmo@s{#1}{#2}}
% This is just \@declmathop without \@ifdefinable
\newcommand\rmo@declmathop[3]{%
  \DeclareRobustCommand{#2}{\qopname\newmcodes@#1{#3}}%
}
\@onlypreamble\RedeclareMathOperator
\makeatother

% ============================================================
% Theorem environments
% Standard amsthm styling.
% ============================================================

\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem*{lemma*}{Lemma}
\newtheorem{conjecture}[theorem]{Conjecture}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem*{fact}{Fact}

\newcounter{mycounter}
\renewcommand{\themycounter}{\thesection.\arabic{theorem}}




\theoremstyle{remark}
\newtheorem*{remark}{Remark}
\newtheorem*{example}{Example}
\newtheorem*{hint}{Hint}
\newtheorem*{claim}{Claim}

\newenvironment{claimproof}
  {\par\noindent\emph{Proof of the claim.}\ }
  {\hfill\(\square\)\par}

